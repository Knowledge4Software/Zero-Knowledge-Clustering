# Existing benchmark provenance hashes exact source bytes, including line endings.
# Preserve those bytes across Windows and Unix checkouts.
code/commitjl/** -text whitespace=cr-at-eol
code/experiments/** -text whitespace=cr-at-eol
code/data/** -text whitespace=cr-at-eol
code/analysis/** -text whitespace=cr-at-eol
code/campaigns/** -text whitespace=cr-at-eol
code/tools/** -text whitespace=cr-at-eol
code/figures/** -text whitespace=cr-at-eol
code/tests/** -text whitespace=cr-at-eol
code/validation/** -text whitespace=cr-at-eol
code/zk_external/** -text whitespace=cr-at-eol
code/zk/**/*.go -text whitespace=cr-at-eol
code/zk/go.mod -text whitespace=cr-at-eol
code/zk/go.sum -text whitespace=cr-at-eol
code/campaigns/supplements/engine.py -text whitespace=cr-at-eol
# Evidence digests and frozen paper sources describe bytes, not normalized text.
code/validation/outputs/** -text whitespace=cr-at-eol
paper_results/** -text whitespace=cr-at-eol,-blank-at-eof
manuscript.tex -text whitespace=cr-at-eol
references.bib -text whitespace=cr-at-eol
figures/**/*.pdf binary
output/** -text whitespace=cr-at-eol
reviewer_artifact/** -text whitespace=cr-at-eol
# Generated SVG path formatting is byte-pinned by figure manifests.
*.svg -text whitespace=cr-at-eol,-blank-at-eol
# Ubuntu launchers must retain Unix line endings.
*.sh text eol=lf
evidence/*.zip filter=lfs diff=lfs merge=lfs -text
